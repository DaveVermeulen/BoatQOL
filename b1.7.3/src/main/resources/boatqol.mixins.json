{
  "required": true,
  "minVersion": "0.8",
  "package": "io.github.davevermeulen.boatqol.mixin",
  "compatibilityLevel": "JAVA_8",
  "mixins": [
    "BoatEntityMixin",
    "EntityMixin",
    "PacketMixin",
    "BoatItemMixin"
  ],
  "client": [
    "client.BoatEntityClientMixin",
    "client.LoginHelloPacketMixin",
    "client.EntityClientMixin"
  ],
  "server": [
    "server.ServerLoginNetworkHandlerMixin",
    "server.ServerPlayNetworkHandlerAccessor",
    "server.EntityTrackerEntryMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  }
}
